# Copy to .env on the server (chmod 600). Never commit real values.
BOT_TOKEN=                # from BotFather
ADMIN_IDS=                # comma-separated Telegram ids of people who approve requests
TRIAL_DAYS=7              # how long access lasts, counted from joining
LINK_TTL_HOURS=24         # how long a personal join link works
REMIND_HOURS=24           # how long before the end the person is reminded
WHEEL_BRAND=              # optional: a short word on the plaque under the prize wheel
WHEEL_LOGO=               # optional: picture for the wheel's hub (default: wheel-logo.png next to the database)
EXTRA_CHAT_ID=            # optional: numeric id of the 2nd chat (can also be bound with /bind2)
EXTRA_CHAT_TAG=           # optional: member tag (0-16 chars, no emojis) set in the 2nd chat after TRIAL_DAYS
EXPIRED_TEXT=             # optional: custom message sent when the trial expires (use \n for newlines)
